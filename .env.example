# ═══════════════════════════════════════════════════════════════════════════
# TravelAI Tamil Nadu — Environment Variables (.env)
# Copy this file to .env and fill in your API keys
# ═══════════════════════════════════════════════════════════════════════════

# ── AI Orchestration (7-Engine Fallback Pipeline) ─────────────────────────
# Primary engine
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Fallback engines (optional — system works without them)
VITE_GROQ_API_KEY=
VITE_MISTRAL_API_KEY=
VITE_OPENROUTER_API_KEY=
VITE_TOGETHER_API_KEY=
VITE_COHERE_API_KEY=
VITE_HUGGINGFACE_TOKEN=

# NVIDIA NIM (for structured JSON analysis)
VITE_NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Translation & Voice ──────────────────────────────────────────────────
VITE_SARVAM_API_KEY=your_sarvam_api_key_here

# ── Maps ─────────────────────────────────────────────────────────────────
VITE_OLA_MAPS_API_KEY=your_ola_maps_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Backend Configuration ────────────────────────────────────────────────
# For production deployment (Vercel → Render)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ── Backend-Only Keys (not exposed to frontend) ─────────────────────────
# These are used by the FastAPI backend only
SECRET_KEY=your-secret-key-change-in-production-2026
DATABASE_URL=sqlite:///./tourism.db
# For production: DATABASE_URL=postgresql://user:pass@your-neon-url/dbname

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# Weather API (optional)
WEATHER_API_KEY=your_openweathermap_key
